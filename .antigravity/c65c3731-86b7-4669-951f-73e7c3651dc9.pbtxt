        lines {
          text: "    correctAnswerIndex: 0,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'3x = 16 + 5 => 3x = 21 => x = 7.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
