        }
        lines {
          text: "    const ctx = this.ctx;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (!ctx || !this.isMusicPlaying || !this.masterMusicGain) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
