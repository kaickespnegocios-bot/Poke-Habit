          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    question: \'En la oraci\303\263n \"El gato comi\303\263 pescado r\303\241pidamente\", \302\277qu\303\251 funci\303\263n cumple \"pescado\"?\',"
