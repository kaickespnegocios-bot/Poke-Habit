        }
        lines {
          text: "      this.nextNoteTime += stepDuration;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      this.currentStep = (this.currentStep + 1) % 32; // 32 sixteenth/eighth-step loops"
