  file_change {
    absolute_path_uri: "file:///src/components/SkillTree.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { SkillStats } from \'../types\';\nimport {\n  Dumbbell,\n  Brain,\n  Utensils,\n  Palette,\n  Coins,\n  Sparkles,\n  Zap,\n  TrendingUp,\n  CheckCircle2,\n} from \'lucide-react\';\n\ninterface SkillTreeProps {\n  skillStats: SkillStats;\n}\n\nexport const SkillTree: React.FC<SkillTreeProps> = ({ skillStats }) => {\n  const statsList = [\n    {\n      id: \'fitness\',\n      name: \'Fitness & Actividad F\303\255sica\',\n      data: skillStats.fitness,\n      icon: <Dumbbell className=\"w-6 h-6 text-emerald-400\" />,\n      color: \'from-emerald-500 to-teal-400\',\n      bgLight: \'bg-emerald-950/20 border-emerald-500/40\',\n      source: \'Alimentado por pasos de Health Connect y tareas de Salud/Deporte.\',\n      perks: [\n        \'Nv. 2: +10% XP adicional al caminar\',\n        \'Nv. 4: Huevos eclosionan 15% m\303\241s r\303\241pido\',\n        \'Nv. 6: Desbloqueo de encuentros con Pok\303\251mon tipo Lucha\',\n      ],\n    },\n    {\n      id: \'intelligence\',\n      name: \'Intelligence & Estudio Acad\303\251mico\',\n      data: skillStats.intelligence,\n      icon: <Brain className=\"w-6 h-6 text-pink-400\" />,\n      color: \'from-pink-500 to-rose-400\',\n      bgLight: \'bg-pink-950/20 border-pink-500/40\',\n      source: \'Alimentado por bloques Pomodoro de 3\302\272 ESO y victorias en Repaso de Flashcards.\',\n      perks: [\n        \'Nv. 2: +15% da\303\261o en Boss Battles de ex\303\241menes\',\n        \'Nv. 4: Nuevas preguntas de combate desbloqueadas\',\n        \'Nv. 6: Bonus de oro al aprobar ex\303\241menes con sobresaliente\',\n      ],\n    },\n    {\n      id: \'cooking\',\n      name: \'Cooking & Nutrici\303\263n del Hogar\',\n      data: skillStats.cooking,\n      icon: <Utensils className=\"w-6 h-6 text-orange-400\" />,\n      color: \'from-orange-500 to-amber-400\',\n      bgLight: \'bg-orange-950/20 border-orange-500/40\',\n      source: \'Alimentado por tareas de cocina, preparar comidas y nutrici\303\263n saludable.\',\n      perks: [\n        \'Nv. 2: Pociones curan +20% HP extra a tu equipo\',\n        \'Nv. 4: Multiplicador de oro en tareas de cocina x1.3\',\n        \'Nv. 6: Habilidad de preparar bayas curativas\',\n      ],\n    },\n    {\n      id: \'creativity\',\n      name: \'Creativity & Expresi\303\263n Art\303\255stica\',\n      data: skillStats.creativity,\n      icon: <Palette className=\"w-6 h-6 text-purple-400\" />,\n      color: \'from-purple-500 to-indigo-400\',\n      bgLight: \'bg-purple-950/20 border-purple-500/40\',\n      source: \'Alimentado por tareas de m\303\272sica, pl\303\241stica, lectura y proyectos creativos.\',\n      perks: [\n        \'Nv. 2: Desbloquea avatares de entrenador exclusivos\',\n        \'Nv. 4: Bonus de XP en asignaturas de M\303\272sica y Pl\303\241stica\',\n        \'Nv. 6: Probabilidad de encontrar Pok\303\251mon shiny / raros aumentada\',\n      ],\n    },\n    {\n      id: \'finance\',\n      name: \'Finance & Gesti\303\263n Personal\',\n      data: skillStats.finance,\n      icon: <Coins className=\"w-6 h-6 text-amber-400\" />,\n      color: \'from-amber-500 to-yellow-400\',\n      bgLight: \'bg-amber-950/20 border-amber-500/40\',\n      source: \'Alimentado por registrar ahorros, presupuesto y orden personal.\',\n      perks: [\n        \'Nv. 2: Descuento del 10% en toda la tienda Pok\303\251Mart\',\n        \'Nv. 4: +20% de Oro obtenido en todas las misiones\',\n        \'Nv. 6: Acceso al Huevo Legendario Oculto\',\n      ],\n    },\n  ];\n\n  const totalSkillLevels =\n    skillStats.fitness.level +\n    skillStats.intelligence.level +\n    skillStats.cooking.level +\n    skillStats.creativity.level +\n    skillStats.finance.level;"
