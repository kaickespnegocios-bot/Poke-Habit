        }
        lines {
          text: "    // Start scheduling loop"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    this.musicSchedulerInterval = window.setInterval(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
