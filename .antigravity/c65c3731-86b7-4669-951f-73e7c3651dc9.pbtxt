        }
        lines {
          text: "      \'Tiene dos soluciones reales distintas\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Tiene una \303\272nica soluci\303\263n doble\',"
