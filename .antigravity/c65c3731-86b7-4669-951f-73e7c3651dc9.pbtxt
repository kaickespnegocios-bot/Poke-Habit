  file_change {
    absolute_path_uri: "file:///src/components/StarterModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { STARTER_POKEMON, createStarterInstance } from \'../data/starters\';\nimport { PartyPokemon } from \'../types\';\nimport { POKEMON_TYPES } from \'../data/pokemonTypes\';\nimport { Sparkles, Shield, Swords, Flame, Droplets, Leaf } from \'lucide-react\';\nimport { soundFx } from \'../utils/audio\';\nimport confetti from \'canvas-confetti\';\n\ninterface StarterModalProps {\n  onSelectStarter: (starter: PartyPokemon) => void;\n}\n\nexport const StarterModal: React.FC<StarterModalProps> = ({ onSelectStarter }) => {\n  const [selectedPokedexId, setSelectedPokedexId] = useState<number>(4); // Default Charmander\n\n  const currentStarter = STARTER_POKEMON.find((s) => s.pokedexNumber === selectedPokedexId) || STARTER_POKEMON[0];\n\n  const handleConfirm = () => {\n    soundFx.playLevelUp();\n    confetti({ particleCount: 100, spread: 80 });\n    const instance = createStarterInstance(selectedPokedexId);\n    onSelectStarter(instance);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-4\">\n      <div className=\"bg-slate-900 border-2 border-red-500 rounded-3xl max-w-xl w-full p-6 sm:p-8 shadow-2xl space-y-6 text-center animate-scaleUp\">\n        <div>\n          <span className=\"text-3xl\">\360\237\224\264\342\232\252</span>\n          <h2 className=\"text-2xl font-black text-white mt-1\">\n            \302\241Bienvenido al Mundo de Pok\303\251Quest!\n          </h2>\n          <p className=\"text-xs text-slate-300 mt-1.5 max-w-md mx-auto\">\n            El Profesor Oak te da la bienvenida a 3\302\272 ESO. Para comenzar tu aventura de productividad y estudio, debes elegir a tu primer compa\303\261ero Pok\303\251mon:\n          </p>\n        </div>\n\n        {/* 3 Starter options */}\n        <div className=\"grid grid-cols-3 gap-3\">\n          {STARTER_POKEMON.map((starter) => {\n            const isSelected = starter.pokedexNumber === selectedPokedexId;\n            const typeInfo = POKEMON_TYPES[starter.types[0]];\n\n            return (\n              <div\n                key={starter.pokedexNumber}\n                onClick={() => {\n                  setSelectedPokedexId(starter.pokedexNumber);\n                  soundFx.playClick();\n                }}\n                className={`p-3 rounded-2xl border-2 transition-all cursor-pointer flex flex-col items-center justify-between ${\n                  isSelected\n                    ? \'border-red-500 bg-slate-800 ring-2 ring-red-500/50 scale-105 shadow-xl\'\n                    : \'border-slate-800 bg-slate-850 hover:border-slate-700\'\n                }`}\n              >\n                <div className=\"w-20 h-20 flex items-center justify-center\">\n                  <img\n                    src={starter.officialArtwork}\n                    alt={starter.name}\n                    className=\"w-18 h-18 object-contain drop-shadow\"\n                  />\n                </div>\n                <h4 className=\"text-xs font-black text-white mt-2\">{starter.name}</h4>\n                <span\n                  className=\"text-[9px] font-black px-2 py-0.2 rounded-full uppercase mt-1\"\n                  style={{\n                    backgroundColor: typeInfo.color,\n                    color: typeInfo.textColor,\n                  }}\n                >\n                  {typeInfo.label}\n                </span>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Selected Starter Details */}\n        <div className=\"bg-slate-800/80 border border-slate-700 rounded-2xl p-4 text-left space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-sm font-black text-white flex items-center gap-1.5\">\n              <Sparkles className=\"w-4 h-4 text-amber-400\" />\n              {currentStarter.name} \342\200\224 Nivel 5\n            </h3>\n            <span className=\"text-xs text-slate-400\">\n              Evoluciona a {currentStarter.evolutionTargetName} (Nv. {currentStarter.evolutionLevel})\n            </span>\n          </div>\n\n          <p className=\"text-xs text-slate-300 italic\">\n            \"{currentStarter.description}\"\n          </p>\n\n          <div className=\"flex items-center gap-2 pt-1\">\n            <span className=\"text-[11px] text-slate-400 font-bold\">Movimientos iniciales:</span>\n            {currentStarter.moves.map((m, i) => (\n              <span\n                key={i}\n                className=\"text-[10px] bg-slate-900 px-2 py-0.5 rounded text-white font-mono border border-slate-800\"\n              >\n                {m.name}\n              </span>\n            ))}\n          </div>\n        </div>\n\n        {/* Choose Button */}\n        <button\n          onClick={handleConfirm}\n          className=\"w-full py-3.5 bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 text-white font-black text-sm rounded-2xl shadow-xl cursor-pointer transition-transform active:scale-95 flex items-center justify-center gap-2\"\n        >\n          \302\241Elijo a {currentStarter.name}! \360\237\232\200\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
