        }
        lines {
          text: "  if (rarity === \'comun\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Basic unevolved common pokemon"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    pool = nonLegendaries.filter((p) => [1, 4, 7, 10, 13, 16, 19, 21, 23, 27, 29, 32, 41, 43, 60, 69, 74].includes(p.id)) || nonLegendaries;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } else if (rarity === \'raro\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    pool = nonLegendaries.filter((p) => [25, 37, 58, 63, 77, 92, 116, 120, 123, 133].includes(p.id)) || nonLegendaries;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } else if (rarity === \'epico\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    pool = nonLegendaries.filter((p) => [131, 143, 147, 148, 130, 94, 65, 59, 6].includes(p.id)) || nonLegendaries;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
