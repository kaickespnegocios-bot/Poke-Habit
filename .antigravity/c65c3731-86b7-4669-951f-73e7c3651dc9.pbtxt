        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // 1. Lead Melody Note (Square Wave 50% duty)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (trackScore.lead && NOTE_FREQS[trackScore.lead]) {"
