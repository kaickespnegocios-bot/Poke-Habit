          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let desc = localMatch?.description || `${data.name} registrado en la Pok\303\251dex.`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
