        }
        lines {
          text: "    correctAnswerIndex: 0,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Si el discriminante es positivo, existen dos soluciones reales distintas.\',"
