      replacement_content: "import React from \'react\';\nimport {\n  LayoutDashboard,\n  CheckSquare,\n  GraduationCap,\n  Users,\n  Footprints,\n  BookOpen,\n  ShoppingBag,\n  Trophy,\n  GitBranch,\n  Code2,\n} from \'lucide-react\';\nimport { soundFx } from \'../utils/audio\';\n\nexport type TabKey =\n  | \'dashboard\'\n  | \'tasks\'\n  | \'study\'\n  | \'party\'\n  | \'daily\'\n  | \'pokedex\'\n  | \'shop\'\n  | \'achievements\'\n  | \'skills\'\n  | \'android_code\';\n\ninterface NavigationProps {\n  activeTab: TabKey;\n  onTabChange: (tab: TabKey) => void;\n  pendingTasksCount: number;\n  pendingHabitsCount: number;\n  readyEvolutionsCount: number;\n}\n\nexport const Navigation: React.FC<NavigationProps> = ({\n  activeTab,\n  onTabChange,\n  pendingTasksCount,\n  pendingHabitsCount,\n  readyEvolutionsCount,\n}) => {\n  const tabs: {\n    id: TabKey;\n    label: string;\n    icon: React.ReactNode;\n    badge?: number;\n    highlight?: boolean;\n  }[] = [\n    {\n      id: \'dashboard\',\n      label: \'Dashboard\',\n      icon: <LayoutDashboard className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'tasks\',\n      label: \'Tareas Hogar\',\n      icon: <CheckSquare className=\"w-4 h-4\" />,\n      badge: pendingTasksCount > 0 ? pendingTasksCount : undefined,\n    },\n    {\n      id: \'study\',\n      label: \'Estudio 3\302\272 ESO\',\n      icon: <GraduationCap className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'party\',\n      label: \'Equipo & PC\',\n      icon: <Users className=\"w-4 h-4\" />,\n      badge: readyEvolutionsCount > 0 ? readyEvolutionsCount : undefined,\n    },\n    {\n      id: \'daily\',\n      label: \'Daily & Pasos\',\n      icon: <Footprints className=\"w-4 h-4\" />,\n      badge: pendingHabitsCount > 0 ? pendingHabitsCount : undefined,\n    },\n    {\n      id: \'pokedex\',\n      label: \'Pok\303\251dex\',\n      icon: <BookOpen className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'shop\',\n      label: \'Tienda & Huevos\',\n      icon: <ShoppingBag className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'achievements\',\n      label: \'Legendarios\',\n      icon: <Trophy className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'skills\',\n      label: \'Skill Tree\',\n      icon: <GitBranch className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'android_code\',\n      label: \'C\303\263digo Android\',\n      icon: <Code2 className=\"w-4 h-4 text-emerald-400\" />,\n      highlight: true,\n    },\n  ];\n\n  const handleSelect = (tabId: TabKey) => {\n    soundFx.playClick();\n    onTabChange(tabId);\n  };\n\n  return (\n    <nav className=\"bg-slate-900 border-b border-slate-800 sticky top-14 z-30 shadow\">\n      <div className=\"max-w-7xl mx-auto px-2 overflow-x-auto no-scrollbar\">\n        <div className=\"flex items-center space-x-1 py-1.5 min-w-max\">\n          {tabs.map((t) => {\n            const isActive = activeTab === t.id;\n            return (\n              <button\n                key={t.id}\n                onClick={() => handleSelect(t.id)}\n                className={`relative flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer whitespace-nowrap ${\n                  isActive\n                    ? \'bg-red-600 text-white shadow-md shadow-red-600/30\'\n                    : \'text-slate-300 hover:text-white hover:bg-slate-800/80\'\n                } ${t.highlight && !isActive ? \'border border-emerald-500/40 text-emerald-300 bg-emerald-950/30\' : \'\'}`}\n              >\n                {t.icon}\n                <span>{t.label}</span>\n                {t.badge !== undefined && (\n                  <span className=\"bg-amber-400 text-slate-900 text-[10px] font-black px-1.5 py-0.2 rounded-full shadow-sm animate-pulse\">\n                    {t.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </nav>\n  );\n};\n"
    }
