          text: "                const calculatedAvg = ((t1 + t2 + t3) / 3).toFixed(1);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                const avgNum = parseFloat(calculatedAvg);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
