          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    question: \'\302\277Qu\303\251 es el discriminante (b\302\262 - 4ac) en una ecuaci\303\263n de 2\302\272 grado si da > 0?\',"
