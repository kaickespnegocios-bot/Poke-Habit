  file_change {
    absolute_path_uri: "file:///src/components/AudioPlayerWidget.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  soundFx,\n  MUSIC_TRACKS,\n  MusicTrackId,\n} from \'../utils/audio\';\nimport {\n  Volume2,\n  VolumeX,\n  Music,\n  Radio,\n  Play,\n  Square,\n  ChevronUp,\n  ChevronDown,\n  Sparkles,\n  Zap,\n} from \'lucide-react\';\n\ninterface AudioPlayerWidgetProps {\n  currentTab: string;\n}\n\nexport const AudioPlayerWidget: React.FC<AudioPlayerWidgetProps> = ({ currentTab }) => {\n  const [, setTick] = useState(0);\n  const [isExpanded, setIsExpanded] = useState(false);\n\n  useEffect(() => {\n    const unsubscribe = soundFx.subscribe(() => {\n      setTick((t) => t + 1);\n    });\n    return unsubscribe;\n  }, []);\n\n  // When tab changes, let audio engine update track if auto-change is enabled\n  useEffect(() => {\n    soundFx.handleZoneChange(currentTab);\n  }, [currentTab]);\n\n  const isMusicOn = soundFx.isMusicEnabled();\n  const isSfxOn = soundFx.isSfxEnabled();\n  const currentTrackId = soundFx.getCurrentTrackId();\n  const currentTrack = MUSIC_TRACKS[currentTrackId] || MUSIC_TRACKS.route1;\n  const isAutoZone = soundFx.isAutoChangeByZone();\n  const musicVolume = soundFx.getMusicVolume();\n\n  const handleToggleMusic = () => {\n    soundFx.playClick();\n    soundFx.toggleMusic();\n  };\n\n  const handleToggleSfx = () => {\n    soundFx.setSfxEnabled(!isSfxOn);\n    soundFx.playToggle();\n  };\n\n  const handleSelectTrack = (trackId: MusicTrackId) => {\n    soundFx.playClick();\n    soundFx.setTrack(trackId, true);\n  };\n\n  const handleToggleAutoZone = () => {\n    soundFx.playClick();\n    soundFx.setAutoChangeByZone(!isAutoZone);\n    if (!isAutoZone) {\n      soundFx.handleZoneChange(currentTab);\n    }\n  };\n\n  const handleVolumeChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const val = parseFloat(e.target.value);\n    soundFx.setMusicVolume(val);\n  };\n\n  return (\n    <div className=\"fixed bottom-16 sm:bottom-4 right-3 sm:right-6 z-40 max-w-xs sm:max-w-sm transition-all duration-300\">\n      {/* Collapsed Bar / Pill */}\n      {!isExpanded ? (\n        <div className=\"bg-slate-900/95 border-2 border-red-500/80 backdrop-blur-md rounded-2xl p-2 shadow-2xl flex items-center gap-2.5 text-white animate-fadeIn\">\n          {/* Animated Equalizer Bars */}\n          <button\n            onClick={() => {\n              soundFx.playClick();\n              setIsExpanded(true);\n            }}\n            className=\"flex items-center gap-2 bg-slate-800/90 hover:bg-slate-750 px-2.5 py-1.5 rounded-xl cursor-pointer transition-colors text-left\"\n          >\n            <div className=\"w-5 h-5 flex items-center justify-center text-red-400\">\n              <Music className={`w-4 h-4 ${isMusicOn ? \'animate-bounce text-red-400\' : \'text-slate-500\'}`} />\n            </div>\n\n            <div className=\"max-w-[120px] sm:max-w-[150px] overflow-hidden\">\n              <p className=\"text-[11px] font-black text-white truncate leading-tight\">\n                {isMusicOn ? currentTrack.title : \'M\303\272sica Silenciada\'}\n              </p>\n              <div className=\"flex items-center gap-1\">\n                {isMusicOn ? (\n                  <span className=\"flex items-end gap-0.5 h-2\">\n                    <span className=\"w-0.5 h-2 bg-red-400 animate-pulse\" />\n                    <span className=\"w-0.5 h-3 bg-amber-400 animate-pulse delay-75\" />\n                    <span className=\"w-0.5 h-1.5 bg-emerald-400 animate-pulse delay-150\" />\n                  </span>\n                ) : (\n                  <span className=\"text-[9px] text-slate-400\">8-bit Chiptune</span>\n                )}\n                <span className=\"text-[9px] text-slate-400 truncate\">{currentTrack.mood.split(\'\342\200\242\')[0]}</span>\n              </div>\n            </div>\n\n            <ChevronUp className=\"w-3.5 h-3.5 text-slate-400 ml-1\" />\n          </button>\n\n          {/* Quick Play/Stop button */}\n          <button\n            onClick={handleToggleMusic}\n            className={`w-8 h-8 rounded-xl flex items-center justify-center font-bold transition-transform active:scale-90 cursor-pointer shadow-md ${\n              isMusicOn\n                ? \'bg-red-600 hover:bg-red-500 text-white\'\n                : \'bg-slate-800 hover:bg-slate-700 text-slate-300\'\n            }`}\n            title={isMusicOn ? \'Detener m\303\272sica\' : \'Reproducir m\303\272sica 8-bit\'}\n          >\n            {isMusicOn ? <Square className=\"w-3.5 h-3.5 fill-current\" /> : <Play className=\"w-3.5 h-3.5 fill-current ml-0.5\" />}\n          </button>\n\n          {/* SFX quick toggle */}\n          <button\n            onClick={handleToggleSfx}\n            className={`w-8 h-8 rounded-xl flex items-center justify-center transition-colors cursor-pointer ${\n              isSfxOn ? \'bg-slate-800 text-emerald-400\' : \'bg-slate-800 text-slate-500\'\n            }`}\n            title={isSfxOn ? \'Efectos de sonido activos\' : \'Efectos de sonido silenciados\'}\n          >\n            {isSfxOn ? <Volume2 className=\"w-4 h-4\" /> : <VolumeX className=\"w-4 h-4\" />}\n          </button>\n        </div>\n      ) : (\n        /* Expanded Player Drawer */\n        <div className=\"bg-slate-900/98 border-2 border-red-500 backdrop-blur-lg rounded-3xl p-4 shadow-2xl text-white w-72 sm:w-80 space-y-3.5 animate-scaleUp\">\n          {/* Header */}\n          <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"p-1 bg-red-600/20 text-red-400 rounded-lg\">\n                <Radio className=\"w-4 h-4 animate-spin-slow\" />\n              </span>\n              <div>\n                <h4 className=\"text-xs font-black uppercase tracking-wider text-white\">\n                  Pok\303\251Radio 8-bit FM\n                </h4>\n                <p className=\"text-[10px] text-slate-400\">M\303\272sica procedural aut\303\251ntica</p>\n              </div>\n            </div>\n            <button\n              onClick={() => {\n                soundFx.playClick();\n                setIsExpanded(false);\n              }}\n              className=\"p-1 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 cursor-pointer\"\n            >\n              <ChevronDown className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Now Playing Banner */}\n          <div className=\"bg-slate-800/80 border border-slate-700/80 rounded-2xl p-3 space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[10px] uppercase font-bold text-red-400 flex items-center gap-1\">\n                <Sparkles className=\"w-3 h-3 text-amber-400\" />\n                {isMusicOn ? \'Reproduciendo Ahora\' : \'Pausado\'}\n              </span>\n              <span className=\"text-[10px] font-mono text-slate-400\">{currentTrack.tempo} BPM</span>\n            </div>\n\n            <div>\n              <h3 className=\"text-sm font-black text-white\">{currentTrack.title}</h3>\n              <p className=\"text-[11px] text-slate-300\">{currentTrack.subtitle}</p>\n              <p className=\"text-[10px] text-emerald-400 font-semibold mt-0.5\">{currentTrack.mood}</p>\n            </div>\n\n            {/* Equalizer Visualizer */}\n            {isMusicOn && (\n              <div className=\"flex items-end gap-1 h-4 pt-1 justify-center\">\n                {[40, 70, 90, 60, 100, 80, 50, 90, 65, 85, 45, 95].map((h, idx) => (\n                  <div\n                    key={idx}\n                    className=\"w-1 bg-gradient-to-t from-red-500 via-amber-400 to-emerald-400 rounded-full animate-pulse\"\n                    style={{\n                      height: `${h}%`,\n                      animationDelay: `${idx * 80}ms`,\n                      animationDuration: \'600ms\',\n                    }}\n                  />\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Play/Pause & Volume */}\n          <div className=\"space-y-2 pt-1\">\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={handleToggleMusic}\n                className={`flex-1 py-2.5 rounded-xl font-black text-xs flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-95 shadow-md ${\n                  isMusicOn\n                    ? \'bg-red-600 hover:bg-red-500 text-white\'\n                    : \'bg-emerald-600 hover:bg-emerald-500 text-white\'\n                }`}\n              >\n                {isMusicOn ? (\n                  <>\n                    <Square className=\"w-3.5 h-3.5 fill-current\" /> Pausar M\303\272sica\n                  </>\n                ) : (\n                  <>\n                    <Play className=\"w-3.5 h-3.5 fill-current\" /> Reproducir M\303\272sica 8-Bit\n                  </>\n                )}\n              </button>\n\n              <button\n                onClick={handleToggleSfx}\n                className={`px-3 py-2.5 rounded-xl text-xs font-bold flex items-center gap-1.5 cursor-pointer border ${\n                  isSfxOn\n                    ? \'bg-slate-800 border-slate-700 text-emerald-400\'\n                    : \'bg-slate-800/50 border-slate-800 text-slate-500\'\n                }`}\n                title=\"Efectos de sonido\"\n              >\n                {isSfxOn ? <Volume2 className=\"w-4 h-4\" /> : <VolumeX className=\"w-4 h-4\" />}\n                <span>SFX</span>\n              </button>\n            </div>\n\n            {/* Volume Slider */}\n            <div className=\"flex items-center gap-2 bg-slate-800/50 px-3 py-1.5 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] text-slate-400 font-bold whitespace-nowrap\">Volumen BGM:</span>\n              <input\n                type=\"range\"\n                min=\"0\"\n                max=\"1\"\n                step=\"0.05\"\n                value={musicVolume}\n                onChange={handleVolumeChange}\n                className=\"w-full accent-red-500 cursor-pointer h-1.5 bg-slate-700 rounded-lg\"\n              />\n              <span className=\"text-[10px] font-mono text-slate-300\">{Math.round(musicVolume * 100)}%</span>\n            </div>\n          </div>\n\n          {/* Auto Change by Zone Checkbox */}\n          <div\n            onClick={handleToggleAutoZone}\n            className=\"flex items-center justify-between bg-slate-800/60 hover:bg-slate-800 p-2.5 rounded-xl cursor-pointer border border-slate-800 transition-colors\"\n          >\n            <div className=\"flex items-center gap-2\">\n              <Zap className={`w-3.5 h-3.5 ${isAutoZone ? \'text-amber-400\' : \'text-slate-500\'}`} />\n              <div>\n                <p className=\"text-[11px] font-bold text-white\">M\303\272sica din\303\241mica por zona</p>\n                <p className=\"text-[9px] text-slate-400\">Cambia de pista seg\303\272n la pantalla</p>\n              </div>\n            </div>\n            <div\n              className={`w-9 h-5 rounded-full p-0.5 transition-colors ${\n                isAutoZone ? \'bg-red-600 justify-end\' : \'bg-slate-700 justify-start\'\n              } flex items-center`}\n            >\n              <div className=\"w-4 h-4 bg-white rounded-full shadow-sm\" />\n            </div>\n          </div>\n\n          {/* Track Selection List */}\n          <div>\n            <p className=\"text-[10px] font-black uppercase text-slate-400 tracking-wider mb-1.5\">\n              Pistas Disponibles (Chiptune):\n            </p>\n            <div className=\"grid grid-cols-1 gap-1 max-h-36 overflow-y-auto no-scrollbar pr-1\">\n              {(Object.keys(MUSIC_TRACKS) as MusicTrackId[]).map((tid) => {\n                const tr = MUSIC_TRACKS[tid];\n                const isSelected = currentTrackId === tid;\n                return (\n                  <button\n                    key={tid}\n                    onClick={() => handleSelectTrack(tid)}\n                    className={`w-full text-left px-2.5 py-1.5 rounded-xl text-xs flex items-center justify-between transition-colors cursor-pointer ${\n                      isSelected\n                        ? \'bg-red-600/30 border border-red-500/60 text-white font-bold\'\n                        : \'bg-slate-800/40 hover:bg-slate-800 border border-transparent text-slate-300\'\n                    }`}\n                  >\n                    <div className=\"truncate\">\n                      <p className=\"text-[11px] truncate leading-tight\">{tr.title}</p>\n                      <p className=\"text-[9px] text-slate-400 truncate\">{tr.subtitle}</p>\n                    </div>\n                    {isSelected && isMusicOn && (\n                      <span className=\"text-[10px] text-red-400 font-bold ml-1\">\342\226\266</span>\n                    )}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
