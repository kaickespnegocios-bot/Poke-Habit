    replacement_chunks {
      replacement_content: "import {\n  Achievement,\n  DailyHabit,\n  ExamBoss,\n  Flashcard,\n  ShopItem,\n  SkillStats,\n  Subject3ESO,\n  Task,\n  TrainerProfile,\n} from \'../types\';\n\nexport const INITIAL_SUBJECTS: Subject3ESO[] = [\n  {\n    id: \'matematicas\',\n    name: \'Matem\303\241ticas\',\n    pokemonType: \'psychic\',\n    iconName: \'Calculator\',\n    color: \'#F85888\',\n    description: \'\303\201lgebra, funciones, geometr\303\255a y estad\303\255stica. Requiere concentraci\303\263n ps\303\255quica.\',\n    currentGrade: 8.5,\n  },\n  {\n    id: \'lengua\',\n    name: \'Lengua Castellana y Literatura\',\n    pokemonType: \'normal\',\n    iconName: \'BookOpen\',\n    color: \'#A8A878\',\n    description: \'Sintaxis, morfolog\303\255a, literatura medieval y del Siglo de Oro.\',\n    currentGrade: 7.8,\n  },\n  {\n    id: \'ingles\',\n    name: \'Ingl\303\251s\',\n    pokemonType: \'flying\',\n    iconName: \'Globe\',\n    color: \'#A890F0\',\n    description: \'Grammar, vocabulary, listening & speaking. Conecta con el mundo.\',\n    currentGrade: 9.0,\n  },\n  {\n    id: \'biologia\',\n    name: \'Biolog\303\255a y Geolog\303\255a\',\n    pokemonType: \'grass\',\n    iconName: \'Dna\',\n    color: \'#78C850\',\n    description: \'Anatom\303\255a humana, nutrici\303\263n, relieve terrestre y ecosistemas vivos.\',\n    currentGrade: 8.0,\n  },\n  {\n    id: \'fisica_quimica\',\n    name: \'F\303\255sica y Qu\303\255mica\',\n    pokemonType: \'fire\',\n    iconName: \'Flame\',\n    color: \'#F08030\',\n    description: \'Reacciones qu\303\255micas, tabla peri\303\263dica, cinem\303\241tica y leyes de la energ\303\255a.\',\n    currentGrade: 7.5,\n  },\n  {\n    id: \'geografia_historia\',\n    name: \'Geograf\303\255a e Historia\',\n    pokemonType: \'ground\',\n    iconName: \'Compass\',\n    color: \'#E0C068\',\n    description: \'Geograf\303\255a econ\303\263mica mundial, demograf\303\255a y la Edad Moderna.\',\n    currentGrade: 8.2,\n  },\n  {\n    id: \'educacion_fisica\',\n    name: \'Educaci\303\263n F\303\255sica\',\n    pokemonType: \'fighting\',\n    iconName: \'Trophy\',\n    color: \'#C03028\',\n    description: \'Condici\303\263n f\303\255sica, atletismo, deportes en equipo y salud corporal.\',\n    currentGrade: 9.5,\n  },\n  {\n    id: \'tecnologia\',\n    name: \'Tecnolog\303\255a y Digitalizaci\303\263n\',\n    pokemonType: \'steel\',\n    iconName: \'Cpu\',\n    color: \'#B8B8D0\',\n    description: \'Programaci\303\263n, circuitos electr\303\263nicos, mecanismos y dise\303\261o 3D.\',\n    currentGrade: 8.8,\n  },\n  {\n    id: \'musica\',\n    name: \'M\303\272sica\',\n    pokemonType: \'fairy\',\n    iconName: \'Music\',\n    color: \'#EE99AC\',\n    description: \'Historia de la m\303\272sica, ritmo, lenguaje musical y pr\303\241ctica auditiva.\',\n    currentGrade: 8.0,\n  },\n  {\n    id: \'plastica\',\n    name: \'Educaci\303\263n Pl\303\241stica y Visual\',\n    pokemonType: \'ice\',\n    iconName: \'PenTool\',\n    color: \'#98D8D8\',\n    description: \'Dibujo t\303\251cnico, perspectiva, color y composici\303\263n visual.\',\n    currentGrade: 8.4,\n  },\n  {\n    id: \'valores_religion\',\n    name: \'Valores \303\211ticos / Religi\303\263n\',\n    pokemonType: \'psychic\',\n    iconName: \'HeartHandshake\',\n    color: \'#F85888\',\n    description: \'\303\211tica c\303\255vica, derechos humanos y filosof\303\255a reflexiva.\',\n    currentGrade: 9.0,\n  },\n];\n\nexport const INITIAL_TASKS: Task[] = [\n  {\n    id: \'task_1\',\n    title: \'Recoger y ordenar mi habitaci\303\263n\',\n    description: \'Dejar el escritorio despejado y la ropa guardada en el armario.\',\n    category: \'hogar_ordenar\',\n    pokemonType: \'psychic\',\n    difficulty: \'media\',\n    xpReward: 70,\n    goldReward: 35,\n    completed: false,\n  },\n  {\n    id: \'task_2\',\n    title: \'Fregar los platos del almuerzo\',\n    description: \'Lavar platos, cubiertos y sartenes dej\303\241ndolo todo limpio.\',\n    category: \'hogar_fregar\',\n    pokemonType: \'water\',\n    difficulty: \'facil\',\n    xpReward: 30,\n    goldReward: 15,\n    completed: false,\n  },\n  {\n    id: \'task_3\',\n    title: \'Barrer y fregar el suelo del sal\303\263n\',\n    description: \'Eliminar el polvo y dejar reluciente el suelo.\',\n    category: \'hogar_barrer\',\n    pokemonType: \'ground\',\n    difficulty: \'media\',\n    xpReward: 70,\n    goldReward: 35,\n    completed: false,\n  },\n  {\n    id: \'task_4\',\n    title: \'Bajar la bolsa de basura y reciclar pl\303\241stico\',\n    description: \'Llevar los residuos a sus respectivos contenedores.\',\n    category: \'hogar_basura\',\n    pokemonType: \'poison\',\n    difficulty: \'facil\',\n    xpReward: 30,\n    goldReward: 15,\n    completed: false,\n  },\n  {\n    id: \'task_5\',\n    title: \'Hacer ejercicios de Matem\303\241ticas (\303\201lgebra tema 3)\',\n    description: \'Resolver los 6 problemas del libro de 3\302\272 ESO.\',\n    category: \'estudio_general\',\n    pokemonType: \'psychic\',\n    difficulty: \'dificil\',\n    xpReward: 150,\n    goldReward: 80,\n    completed: false,\n  },\n  {\n    id: \'task_6\',\n    title: \'Regar las plantas de la terraza\',\n    description: \'Comprobar la tierra de las macetas y regar con cuidado.\',\n    category: \'hogar_jardin\',\n    pokemonType: \'grass\',\n    difficulty: \'facil\',\n    xpReward: 30,\n    goldReward: 15,\n    completed: false,\n  },\n  {\n    id: \'task_7\',\n    title: \'Limpieza profunda del trastero (Gym Boss Task)\',\n    description: \'Clasificar cajas viejas, barrer y organizar estanter\303\255as a fondo.\',\n    category: \'hogar_ordenar\',\n    pokemonType: \'psychic\',\n    difficulty: \'legendaria\',\n    xpReward: 350,\n    goldReward: 200,\n    completed: false,\n  },\n];\n\nexport const INITIAL_DAILY_HABITS: DailyHabit[] = [\n  {\n    id: \'habit_steps\',\n    title: \'Completar objetivo diario de 8.000 pasos (Health Connect)\',\n    type: \'health_connect_steps\',\n    targetSteps: 8000,\n    completed: false,\n    pokemonType: \'fighting\',\n    xpReward: 120,\n    goldReward: 60,\n  },\n  {\n    id: \'habit_bed\',\n    title: \'Hacer la cama al levantarse\',\n    type: \'manual\',\n    completed: false,\n    pokemonType: \'normal\',\n    xpReward: 25,\n    goldReward: 15,\n  },\n  {\n    id: \'habit_water\',\n    title: \'Beber 2 litros de agua durante el d\303\255a\',\n    type: \'manual\',\n    completed: false,\n    pokemonType: \'water\',\n    xpReward: 30,\n    goldReward: 15,\n  },\n  {\n    id: \'habit_study\',\n    title: \'Hacer al menos 1 bloque Pomodoro (25 min de estudio)\',\n    type: \'manual\',\n    completed: false,\n    pokemonType: \'psychic\',\n    xpReward: 50,\n    goldReward: 25,\n  },\n  {\n    id: \'habit_reading\',\n    title: \'15 minutos de lectura de un libro o art\303\255culo\',\n    type: \'manual\',\n    completed: false,\n    pokemonType: \'fairy\',\n    xpReward: 30,\n    goldReward: 15,\n  },\n];\n\nexport const INITIAL_EXAM_BOSSES: ExamBoss[] = [\n  {\n    id: \'exam_mate_1\',\n    subjectId: \'matematicas\',\n    title: \'Examen de \303\201lgebra y Polinomios (3\302\272 ESO)\',\n    date: \'2026-09-15\',\n    maxHp: 500,\n    currentHp: 350,\n    status: \'upcoming\',\n    bossPokemonId: 65, // Alakazam\n    bossPokemonName: \'Alakazam Sabio\',\n    bossSprite: \'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/65.png\',\n    rewardGold: 300,\n    rewardXp: 500,\n    badgeName: \'Insignia Ps\303\255quica Pitag\303\263rica\',\n    badgeSprite: \'\360\237\224\256\',\n  },\n  {\n    id: \'exam_fq_1\',\n    subjectId: \'fisica_quimica\',\n    title: \'Control de Reacciones Qu\303\255micas y Leyes de los Gases\',\n    date: \'2026-09-22\',\n    maxHp: 600,\n    currentHp: 600,\n    status: \'upcoming\',\n    bossPokemonId: 126, // Magmar\n    bossPokemonName: \'Magmar Volc\303\241nico\',\n    bossSprite: \'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/126.png\',\n    rewardGold: 350,\n    rewardXp: 550,\n    badgeName: \'Insignia \303\215gnea Molecular\',\n    badgeSprite: \'\360\237\224\245\',\n  },\n];\n\nexport const INITIAL_FLASHCARDS: Flashcard[] = [\n  {\n    id: \'fc_1\',\n    subjectId: \'matematicas\',\n    question: \'\302\277Cu\303\241l es la soluci\303\263n de la ecuaci\303\263n 3x - 5 = 16?\',\n    options: [\'x = 7\', \'x = 5\', \'x = 9\', \'x = 3\'],\n    correctAnswerIndex: 0,\n    explanation: \'3x = 16 + 5 => 3x = 21 => x = 7.\',\n  },\n  {\n    id: \'fc_2\',\n    subjectId: \'matematicas\',\n    question: \'\302\277Qu\303\251 es el discriminante (b\302\262 - 4ac) en una ecuaci\303\263n de 2\302\272 grado si da > 0?\',\n    options: [\n      \'Tiene dos soluciones reales distintas\',\n      \'Tiene una \303\272nica soluci\303\263n doble\',\n      \'No tiene soluciones reales\',\n      \'La ecuaci\303\263n no tiene grado 2\',\n    ],\n    correctAnswerIndex: 0,\n    explanation: \'Si el discriminante es positivo, existen dos soluciones reales distintas.\',\n  },\n  {\n    id: \'fc_3\',\n    subjectId: \'fisica_quimica\',\n    question: \'\302\277Cu\303\241l es la f\303\263rmula qu\303\255mica del di\303\263xido de carbono?\',\n    options: [\'CO\342\202\202\', \'H\342\202\202O\', \'NaCl\', \'O\342\202\202\'],\n    correctAnswerIndex: 0,\n    explanation: \'El di\303\263xido de carbono est\303\241 formado por 1 \303\241tomo de carbono y 2 de ox\303\255geno.\',\n  },\n  {\n    id: \'fc_4\',\n    subjectId: \'biologia\',\n    question: \'\302\277Qu\303\251 org\303\241nulo celular se encarga de la respiraci\303\263n celular y producci\303\263n de energ\303\255a ATP?\',\n    options: [\'Mitocondria\', \'Ribosoma\', \'Aparato de Golgi\', \'Lisosoma\'],\n    correctAnswerIndex: 0,\n    explanation: \'Las mitocondrias son las centrales energ\303\251ticas de las c\303\251lulas eucariotas.\',\n  },\n  {\n    id: \'fc_5\',\n    subjectId: \'lengua\',\n    question: \'En la oraci\303\263n \"El gato comi\303\263 pescado r\303\241pidamente\", \302\277qu\303\251 funci\303\263n cumple \"pescado\"?\',\n    options: [\'Complemento Directo (CD)\', \'Complemento Indirecto (CI)\', \'Sujeto Paciente\', \'Atributo\'],\n    correctAnswerIndex: 0,\n    explanation: \'\"El gato lo comi\303\263\" -> Sustituible por \"lo\", es Complemento Directo.\',\n  },\n  {\n    id: \'fc_6\',\n    subjectId: \'ingles\',\n    question: \'Choose the correct form: \"She ___ to London three times this year.\"\',\n    options: [\'has been\', \'was went\', \'have gone\', \'is been\'],\n    correctAnswerIndex: 0,\n    explanation: \'Present Perfect \"has been\" is used for life experiences up to now.\',\n  },\n  {\n    id: \'fc_7\',\n    subjectId: \'geografia_historia\',\n    question: \'\302\277En qu\303\251 a\303\261o comenz\303\263 la Revoluci\303\263n Francesa?\',\n    options: [\'1789\', \'1492\', \'1808\', \'1914\'],\n    correctAnswerIndex: 0,\n    explanation: \'La Revoluci\303\263n Francesa comenz\303\263 en 1789 con la toma de la Bastilla.\',\n  },\n  {\n    id: \'fc_8\',\n    subjectId: \'tecnologia\',\n    question: \'En programaci\303\263n, \302\277qu\303\251 estructura se usa para repetir un bloque de c\303\263digo mientras se cumpla una condici\303\263n?\',\n    options: [\'Bucle While / For\', \'Condicional If\', \'Variable Const\', \'Funci\303\263n Print\'],\n    correctAnswerIndex: 0,\n    explanation: \'Los bucles (loops) While y For permiten ejecutar instrucciones repetidamente.\',\n  },\n];\n\nexport const INITIAL_SHOP_ITEMS: ShopItem[] = [\n  {\n    id: \'egg_common\',\n    name: \'Huevo Com\303\272n (2 km)\',\n    description: \'Huevo Pok\303\251mon com\303\272n. Eclosiona tras 2.000 pasos o con incubaci\303\263n acelerada. Excluye legendarios.\',\n    cost: 100,\n    category: \'egg\',\n    rarity: \'comun\',\n    icon: \'\360\237\245\232\',\n  },\n  {\n    id: \'egg_rare\',\n    name: \'Huevo Raro (5 km)\',\n    description: \'Huevo con alta probabilidad de starters de todas las regiones y Pok\303\251mon poco comunes. Excluye legendarios.\',\n    cost: 250,\n    category: \'egg\',\n    rarity: \'raro\',\n    icon: \'\342\234\250\',\n  },\n  {\n    id: \'egg_epic\',\n    name: \'Huevo \303\211pico (10 km)\',\n    description: \'Huevo de m\303\241xima categor\303\255a para Pok\303\251mon poderosos y pseudo-legendarios (Lapras, Snorlax, Dratini, Larvitar). Excluye legendarios.\',\n    cost: 500,\n    category: \'egg\',\n    rarity: \'epico\',\n    icon: \'\360\237\214\237\',\n  },\n  {\n    id: \'potion_normal\',\n    name: \'Poci\303\263n Curativa\',\n    description: \'Restaura 50 puntos de salud (HP) a un Pok\303\251mon de tu equipo.\',\n    cost: 50,\n    category: \'potion\',\n    healAmount: 50,\n    icon: \'\360\237\247\252\',\n  },\n  {\n    id: \'potion_super\',\n    name: \'Super Poci\303\263n\',\n    description: \'Restaura 150 puntos de salud (HP) a un Pok\303\251mon de tu equipo.\',\n    cost: 120,\n    category: \'potion\',\n    healAmount: 150,\n    icon: \'\360\237\247\252\',\n  },\n  {\n    id: \'rare_candy\',\n    name: \'Caramelo Raro (Rare Candy)\',\n    description: \'Aumenta instant\303\241neamente 1 nivel completo a cualquier Pok\303\251mon de tu equipo.\',\n    cost: 300,\n    category: \'candy\',\n    icon: \'\360\237\215\254\',\n  },\n  {\n    id: \'pokeball\',\n    name: \'Pok\303\251 Ball\',\n    description: \'C\303\241psula est\303\241ndar para capturar Pok\303\251mon salvajes que aparezcan tras completar tareas.\',\n    cost: 30,\n    category: \'ball\',\n    catchBonus: 1.0,\n    icon: \'\360\237\224\264\',\n  },\n  {\n    id: \'superball\',\n    name: \'Super Ball\',\n    description: \'C\303\241psula con mayor ratio de captura (+50% de \303\251xito).\',\n    cost: 60,\n    category: \'ball\',\n    catchBonus: 1.5,\n    icon: \'\360\237\224\265\',\n  },\n  {\n    id: \'ultraball\',\n    name: \'Ultra Ball\',\n    description: \'C\303\241psula de alto rendimiento (+100% de