        }
        lines {
          text: "    const beatDuration = 60 / track.tempo; // Duration of 1 beat (quarter note) in seconds"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const stepDuration = beatDuration / 2; // Eighth note step"
