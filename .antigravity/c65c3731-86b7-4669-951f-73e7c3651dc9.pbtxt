        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Schedule ahead 150ms"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    while (this.nextNoteTime < ctx.currentTime + 0.15) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
