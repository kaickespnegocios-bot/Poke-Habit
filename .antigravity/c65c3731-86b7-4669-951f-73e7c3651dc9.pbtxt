        lines {
          text: "  public playClick() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (!this.sfxEnabled) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const ctx = this.getContext();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
