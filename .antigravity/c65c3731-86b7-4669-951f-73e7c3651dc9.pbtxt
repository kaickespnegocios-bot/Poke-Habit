      replacement_content: "import React from \'react\';\nimport { TrainerProfile, PartyPokemon } from \'../types\';\nimport { Volume2, VolumeX, Footprints, Coins, Sparkles, RefreshCw } from \'lucide-react\';\nimport { soundFx } from \'../utils/audio\';\n\ninterface HeaderProps {\n  trainer: TrainerProfile;\n  party: PartyPokemon[];\n  onToggleSound: () => void;\n  onResetData: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  trainer,\n  party,\n  onToggleSound,\n  onResetData,\n}) => {\n  const leadPokemon = party[0];\n\n  return (\n    <header className=\"bg-gradient-to-r from-red-600 via-red-500 to-rose-600 text-white shadow-md border-b-4 border-red-700 sticky top-0 z-40\">\n      <div className=\"max-w-7xl mx-auto px-4 py-2.5 flex items-center justify-between gap-2 flex-wrap\">\n        {/* Brand & Trainer */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"relative w-10 h-10 bg-white/20 rounded-full flex items-center justify-center p-1 border-2 border-white/50 shadow-inner\">\n            <div className=\"w-4 h-4 bg-white rounded-full border-2 border-red-600 shadow flex items-center justify-center\">\n              <div className=\"w-1.5 h-1.5 bg-red-600 rounded-full animate-ping opacity-75\" />\n            </div>\n            {/* Pokeball outer ring design */}\n            <div className=\"absolute inset-0 rounded-full border border-white/30\" />\n          </div>\n\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"font-black tracking-wider text-xl drop-shadow-sm uppercase flex items-center gap-1.5\">\n                Pok\303\251Quest\n              </h1>\n              <span className=\"text-[10px] bg-red-800/80 text-red-100 font-bold px-2 py-0.5 rounded-full border border-red-400/40\">\n                v1.0 Native Spec\n              </span>\n            </div>\n            <div className=\"flex items-center gap-2 text-xs text-red-100 font-medium\">\n              <span>{trainer.name}</span>\n              <span>\342\200\242</span>\n              <span className=\"bg-white/20 px-1.5 py-0.2 rounded text-[11px] font-bold\">\n                Nivel {trainer.level}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Lead Pok\303\251mon Mini Badge */}\n        {leadPokemon && (\n          <div className=\"hidden sm:flex items-center gap-2 bg-black/20 hover:bg-black/30 transition-colors px-3 py-1.5 rounded-xl border border-white/20\">\n            <img\n              src={leadPokemon.sprite}\n              alt={leadPokemon.name}\n              className=\"w-8 h-8 object-contain pixelated drop-shadow\"\n            />\n            <div className=\"text-xs\">\n              <p className=\"font-bold text-white leading-tight\">\n                {leadPokemon.nickname || leadPokemon.name}\n              </p>\n              <p className=\"text-[10px] text-red-200\">\n                Nv. {leadPokemon.level} \342\200\242 {leadPokemon.hp}/{leadPokemon.maxHp} HP\n              </p>\n            </div>\n          </div>\n        )}\n\n        {/* Currency & Quick Stats */}\n        <div className=\"flex items-center gap-2 sm:gap-4 text-xs font-bold\">\n          {/* Steps Today */}\n          <div\n            className=\"flex items-center gap-1.5 bg-white/15 px-3 py-1.5 rounded-lg border border-white/25 shadow-sm\"\n            title=\"Pasos le\303\255dos de Health Connect hoy\"\n          >\n            <Footprints className=\"w-4 h-4 text-emerald-300\" />\n            <span className=\"text-emerald-100\">{trainer.stepsToday.toLocaleString()}</span>\n            <span className=\"text-[10px] text-white/70\">/ {trainer.stepGoal.toLocaleString()}</span>\n          </div>\n\n          {/* Gold */}\n          <div\n            className=\"flex items-center gap-1.5 bg-amber-400/20 text-amber-200 px-3 py-1.5 rounded-lg border border-amber-300/40 shadow-sm\"\n            title=\"Oro disponible\"\n          >\n            <Coins className=\"w-4 h-4 text-amber-300\" />\n            <span className=\"text-amber-100\">{trainer.gold.toLocaleString()}</span>\n          </div>\n\n          {/* Sound Mute Toggle */}\n          <button\n            onClick={onToggleSound}\n            className=\"p-1.5 bg-white/15 hover:bg-white/25 rounded-lg border border-white/25 transition-colors cursor-pointer\"\n            title={trainer.soundEnabled ? \'Silenciar efectos 8-bit\' : \'Activar sonido 8-bit\'}\n          >\n            {trainer.soundEnabled ? (\n              <Volume2 className=\"w-4 h-4 text-white\" />\n            ) : (\n              <VolumeX className=\"w-4 h-4 text-white/60\" />\n            )}\n          </button>\n\n          {/* Reset button */}\n          <button\n            onClick={onResetData}\n            className=\"p-1.5 bg-white/10 hover:bg-red-800 rounded-lg border border-white/20 transition-colors cursor-pointer text-white/80 hover:text-white\"\n            title=\"Reiniciar datos locales\"\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
