        lines {
          text: "    subjectId: \'matematicas\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    question: \'\302\277Cu\303\241l es la soluci\303\263n de la ecuaci\303\263n 3x - 5 = 16?\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
