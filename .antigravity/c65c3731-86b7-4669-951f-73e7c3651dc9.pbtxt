        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // 2. Harmony / Chords (Square or Triangle Wave)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (trackScore.harmony && NOTE_FREQS[trackScore.harmony]) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const freq = NOTE_FREQS[trackScore.harmony];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
