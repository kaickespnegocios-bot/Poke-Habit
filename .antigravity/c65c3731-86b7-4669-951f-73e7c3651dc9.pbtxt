        }
        lines {
          text: "      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      osc.connect(gain);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      gain.connect(ctx.destination);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      osc.start(now);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      osc.stop(now + 0.04);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
