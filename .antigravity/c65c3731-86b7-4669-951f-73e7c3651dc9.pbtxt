        }
        lines {
          text: "    // 3. Bass Line (Triangle Wave)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (trackScore.bass && NOTE_FREQS[trackScore.bass]) {"
