        }
        lines {
          text: "      gain.gain.setValueAtTime(0.2, time);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      gain.gain.exponentialRampToValueAtTime(0.001, time + noteLength);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      osc.connect(gain);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      gain.connect(this.masterMusicGain);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      osc.start(time);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      osc.stop(time + noteLength);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
