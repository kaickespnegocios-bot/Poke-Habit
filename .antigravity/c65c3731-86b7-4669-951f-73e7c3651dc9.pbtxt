        }
        lines {
          text: "      const freq = NOTE_FREQS[trackScore.lead];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const osc = this.ctx.createOscillator();"
