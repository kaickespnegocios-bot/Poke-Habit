    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  LayoutDashboard,\n  CheckSquare,\n  GraduationCap,\n  Users,\n  Footprints,\n  BookOpen,\n  ShoppingBag,\n  Trophy,\n  GitBranch,\n  Heart,\n  MoreHorizontal,\n  X,\n} from \'lucide-react\';\nimport { soundFx } from \'../utils/audio\';\n\nexport type TabKey =\n  | \'dashboard\'\n  | \'tasks\'\n  | \'study\'\n  | \'party\'\n  | \'daily\'\n  | \'pokedex\'\n  | \'shop\'\n  | \'achievements\'\n  | \'skills\'\n  | \'sexual_health\';\n\ninterface NavigationProps {\n  activeTab: TabKey;\n  onTabChange: (tab: TabKey) => void;\n  pendingTasksCount: number;\n  pendingHabitsCount: number;\n  readyEvolutionsCount: number;\n}\n\nexport const Navigation: React.FC<NavigationProps> = ({\n  activeTab,\n  onTabChange,\n  pendingTasksCount,\n  pendingHabitsCount,\n  readyEvolutionsCount,\n}) => {\n  const [showMoreModal, setShowMoreModal] = useState(false);\n\n  const tabs: {\n    id: TabKey;\n    label: string;\n    icon: React.ReactNode;\n    badge?: number;\n    highlight?: boolean;\n    category?: string;\n  }[] = [\n    {\n      id: \'dashboard\',\n      label: \'Dashboard\',\n      icon: <LayoutDashboard className=\"w-4 h-4\" />,\n      category: \'Principal\',\n    },\n    {\n      id: \'tasks\',\n      label: \'Tareas Hogar\',\n      icon: <CheckSquare className=\"w-4 h-4\" />,\n      badge: pendingTasksCount > 0 ? pendingTasksCount : undefined,\n      category: \'Productividad\',\n    },\n    {\n      id: \'study\',\n      label: \'Estudio 3\302\272 ESO\',\n      icon: <GraduationCap className=\"w-4 h-4\" />,\n      category: \'Productividad\',\n    },\n    {\n      id: \'party\',\n      label: \'Equipo & PC\',\n      icon: <Users className=\"w-4 h-4\" />,\n      badge: readyEvolutionsCount > 0 ? readyEvolutionsCount : undefined,\n      category: \'Pok\303\251mon\',\n    },\n    {\n      id: \'daily\',\n      label: \'Daily & Pasos\',\n      icon: <Footprints className=\"w-4 h-4\" />,\n      badge: pendingHabitsCount > 0 ? pendingHabitsCount : undefined,\n      category: \'Salud\',\n    },\n    {\n      id: \'pokedex\',\n      label: \'Pok\303\251dex\',\n      icon: <BookOpen className=\"w-4 h-4\" />,\n      category: \'Pok\303\251mon\',\n    },\n    {\n      id: \'shop\',\n      label: \'Tienda & Huevos\',\n      icon: <ShoppingBag className=\"w-4 h-4\" />,\n      category: \'Pok\303\251mon\',\n    },\n    {\n      id: \'achievements\',\n      label: \'Legendarios\',\n      icon: <Trophy className=\"w-4 h-4\" />,\n      category: \'Logros\',\n    },\n    {\n      id: \'skills\',\n      label: \'Skill Tree\',\n      icon: <GitBranch className=\"w-4 h-4\" />,\n      category: \'Progreso\',\n    },\n    {\n      id: \'sexual_health\',\n      label: \'Salud Sexual\',\n      icon: <Heart className=\"w-4 h-4 text-rose-400\" />,\n      highlight: true,\n      category: \'Privado\',\n    },\n  ];\n\n  const handleSelect = (tabId: TabKey) => {\n    soundFx.playClick();\n    onTabChange(tabId);\n    setShowMoreModal(false);\n  };\n\n  // Primary mobile tabs\n  const mobilePrimaryTabs: TabKey[] = [\'dashboard\', \'tasks\', \'study\', \'party\'];\n  const isMoreActive = !mobilePrimaryTabs.includes(activeTab);"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  LayoutDashboard,\n  CheckSquare,\n  GraduationCap,\n  Users,\n  Footprints,\n  BookOpen,\n  ShoppingBag,\n  Trophy,\n  GitBranch,\n  Heart,\n  Sparkles,\n  MoreHorizontal,\n  X,\n} from \'lucide-react\';\nimport { soundFx } from \'../utils/audio\';\n\nexport type TabKey =\n  | \'dashboard\'\n  | \'tasks\'\n  | \'study\'\n  | \'party\'\n  | \'pokemon_care\'\n  | \'daily\'\n  | \'pokedex\'\n  | \'shop\'\n  | \'achievements\'\n  | \'skills\'\n  | \'sexual_health\';\n\ninterface NavigationProps {\n  activeTab: TabKey;\n  onTabChange: (tab: TabKey) => void;\n  pendingTasksCount: number;\n  pendingHabitsCount: number;\n  readyEvolutionsCount: number;\n  hungryPokemonCount?: number;\n}\n\nexport const Navigation: React.FC<NavigationProps> = ({\n  activeTab,\n  onTabChange,\n  pendingTasksCount,\n  pendingHabitsCount,\n  readyEvolutionsCount,\n  hungryPokemonCount = 0,\n}) => {\n  const [showMoreModal, setShowMoreModal] = useState(false);\n\n  const tabs: {\n    id: TabKey;\n    label: string;\n    icon: React.ReactNode;\n    badge?: number;\n    highlight?: boolean;\n    category?: string;\n  }[] = [\n    {\n      id: \'dashboard\',\n      label: \'Dashboard\',\n      icon: <LayoutDashboard className=\"w-4 h-4\" />,\n      category: \'Principal\',\n    },\n    {\n      id: \'tasks\',\n      label: \'H\303\241bitos\',\n      icon: <CheckSquare className=\"w-4 h-4\" />,\n      badge: pendingTasksCount > 0 ? pendingTasksCount : undefined,\n      category: \'Productividad\',\n    },\n    {\n      id: \'study\',\n      label: \'Estudios\',\n      icon: <GraduationCap className=\"w-4 h-4\" />,\n      category: \'Productividad\',\n    },\n    {\n      id: \'party\',\n      label: \'Equipo & PC\',\n      icon: <Users className=\"w-4 h-4\" />,\n      badge: readyEvolutionsCount > 0 ? readyEvolutionsCount : undefined,\n      category: \'Pok\303\251mon\',\n    },\n    {\n      id: \'pokemon_care\',\n      label: \'Cuidados & Bayas\',\n      icon: <Sparkles className=\"w-4 h-4 text-emerald-400\" />,\n      badge: hungryPokemonCount > 0 ? hungryPokemonCount : undefined,\n      category: \'Pok\303\251mon\',\n    },\n    {\n      id: \'daily\',\n      label: \'Daily & Pasos\',\n      icon: <Footprints className=\"w-4 h-4\" />,\n      badge: pendingHabitsCount > 0 ? pendingHabitsCount : undefined,\n      category: \'Salud\',\n    },\n    {\n      id: \'pokedex\',\n      label: \'Pok\303\251dex\',\n      icon: <BookOpen className=\"w-4 h-4\" />,\n      category: \'Pok\303\251mon\',\n    },\n    {\n      id: \'shop\',\n      label: \'Tienda & Semillas\',\n      icon: <ShoppingBag className=\"w-4 h-4\" />,\n      category: \'Pok\303\251mon\',\n    },\n    {\n      id: \'achievements\',\n      label: \'Legendarios\',\n      icon: <Trophy className=\"w-4 h-4\" />,\n      category: \'Logros\',\n    },\n    {\n      id: \'skills\',\n      label: \'Skill Tree\',\n      icon: <GitBranch className=\"w-4 h-4\" />,\n      category: \'Progreso\',\n    },\n    {\n      id: \'sexual_health\',\n      label: \'Salud Sexual\',\n      icon: <Heart className=\"w-4 h-4 text-rose-400\" />,\n      highlight: true,\n      category: \'Privado\',\n    },\n  ];\n\n  const handleSelect = (tabId: TabKey) => {\n    soundFx.playClick();\n    onTabChange(tabId);\n    setShowMoreModal(false);\n  };\n\n  // Primary mobile tabs\n  const mobilePrimaryTabs: TabKey[] = [\'dashboard\', \'tasks\', \'study\', \'party\', \'pokemon_care\'];\n  const isMoreActive = !mobilePrimaryTabs.includes(activeTab);"
