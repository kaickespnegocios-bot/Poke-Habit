        target_content: "export type MusicTrackId =\n  | \'route1\'\n  | \'pokecenter\'\n  | \'pokemart\'\n  | \'study_lofi\'\n  | \'cycling_road\'\n  | \'battle\'\n  | \'victory\';\n\nexport interface TrackMetadata {\n  id: MusicTrackId;\n  title: string;\n  subtitle: string;\n  mood: string;\n  tempo: number; // BPM\n}\n\nexport const MUSIC_TRACKS: Record<MusicTrackId, TrackMetadata> = {\n  route1: {\n    id: \'route1\',\n    title: \'Ruta 1 & Pueblo Paleta\',\n    subtitle: \'Aventura & Misiones del Hogar\',\n    mood: \'Alegre \342\200\242 Exploraci\303\263n\',\n    tempo: 128,\n  },\n  pokecenter: {\n    id: \'pokecenter\',\n    title: \'Centro Pok\303\251mon\',\n    subtitle: \'Equipo Pok\303\251mon & PC de Bill\',\n    mood: \'Relajante \342\200\242 Curaci\303\263n\',\n    tempo: 104,\n  },\n  pokemart: {\n    id: \'pokemart\',\n    title: \'Pok\303\251Mart & Bazar\',\n    subtitle: \'Tienda de Objetos & Incubadora\',\n    mood: \'Animado \342\200\242 Compras\',\n    tempo: 136,\n  },\n  study_lofi: {\n    id: \'study_lofi\',\n    title: \'Estudio & Concentraci\303\263n 3\302\272 ESO\',\n    subtitle: \'Pomodoro & Repaso Acad\303\251mico\',\n    mood: \'Calma \342\200\242 Focus Lo-Fi\',\n    tempo: 96,\n  },\n  cycling_road: {\n    id: \'cycling_road\',\n    title: \'Camino de Bicis & Salud\',\n    subtitle: \'H\303\241bitos Diarios & Health Connect\',\n    mood: \'En\303\251rgico \342\200\242 Fitness\',\n    tempo: 144,\n  },\n  battle: {\n    id: \'battle\',\n    title: \'Combate de Gimnasio / Boss\',\n    subtitle: \'Boss de Examen & Flashcards\',\n    mood: \'\303\211pico \342\200\242 Tensi\303\263n\',\n    tempo: 152,\n  },\n  victory: {\n    id: \'victory\',\n    title: \'\302\241Victoria de Entrenador!\',\n    subtitle: \'Santuario de Legendarios\',\n    mood: \'Triunfal \342\200\242 Fanfarria\',\n    tempo: 120,\n  },\n};"
        replacement_content: "export type MusicTrackId =\n  | \'route1\'\n  | \'pallet_town\'\n  | \'pokecenter\'\n  | \'pokemart\'\n  | \'study_lofi\'\n  | \'camp_lofi\'\n  | \'cycling_road\'\n  | \'surf_theme\'\n  | \'lavender_town\'\n  | \'battle\'\n  | \'gym_leader\'\n  | \'victory\';\n\nexport interface TrackMetadata {\n  id: MusicTrackId;\n  title: string;\n  subtitle: string;\n  mood: string;\n  tempo: number; // BPM\n  isLofi?: boolean;\n}\n\nexport const MUSIC_TRACKS: Record<MusicTrackId, TrackMetadata> = {\n  route1: {\n    id: \'route1\',\n    title: \'Ruta 1 (Kanto)\',\n    subtitle: \'Aventura & Tareas Diarias\',\n    mood: \'Alegre \342\200\242 Exploraci\303\263n\',\n    tempo: 128,\n  },\n  pallet_town: {\n    id: \'pallet_town\',\n    title: \'Pueblo Paleta\',\n    subtitle: \'Hogar & Or\303\255genes de Entrenador\',\n    mood: \'Nost\303\241lgico \342\200\242 Paz\',\n    tempo: 98,\n    isLofi: true,\n  },\n  pokecenter: {\n    id: \'pokecenter\',\n    title: \'Centro Pok\303\251mon\',\n    subtitle: \'Equipo Pok\303\251mon & Curaci\303\263n\',\n    mood: \'Relajante \342\200\242 Curaci\303\263n\',\n    tempo: 104,\n  },\n  pokemart: {\n    id: \'pokemart\',\n    title: \'Pok\303\251Mart & Bazar\',\n    subtitle: \'Tienda de Objetos & Semillas de Bayas\',\n    mood: \'Animado \342\200\242 Compras\',\n    tempo: 136,\n  },\n  study_lofi: {\n    id: \'study_lofi\',\n    title: \'Pok\303\251mon Lo-Fi Study Beats\',\n    subtitle: \'Pomodoro & Concentraci\303\263n de Estudios\',\n    mood: \'Calma Profunda \342\200\242 Focus Lo-Fi\',\n    tempo: 84,\n    isLofi: true,\n  },\n  camp_lofi: {\n    id: \'camp_lofi\',\n    title: \'Campamento Pok\303\251mon & Huerto\',\n    subtitle: \'Cuidados de Pok\303\251mon & Cultivo de Bayas\',\n    mood: \'Acogedor \342\200\242 Campestre\',\n    tempo: 96,\n    isLofi: true,\n  },\n  cycling_road: {\n    id: \'cycling_road\',\n    title: \'Camino de Bicis (Cycling Road)\',\n    subtitle: \'H\303\241bitos Saludables & 