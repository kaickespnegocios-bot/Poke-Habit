    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { TrainerProfile, PartyPokemon } from \'../types\';\nimport {\n  Volume2,\n  VolumeX,\n  Footprints,\n  Coins,\n  RefreshCw,\n  Music,\n} from \'lucide-react\';\nimport { soundFx } from \'../utils/audio\';\n\ninterface HeaderProps {\n  trainer: TrainerProfile;\n  party: PartyPokemon[];\n  onToggleSound: () => void;\n  onResetData: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  trainer,\n  party,\n  onToggleSound,\n  onResetData,\n}) => {\n  const [, setTick] = useState(0);\n\n  useEffect(() => {\n    const unsub = soundFx.subscribe(() => setTick((t) => t + 1));\n    return unsub;\n  }, []);\n\n  const leadPokemon = party[0];\n  const isMusicOn = soundFx.isMusicEnabled();\n  const isSfxOn = soundFx.isSfxEnabled();\n\n  const handleToggleSoundMaster = () => {\n    if (isMusicOn || isSfxOn) {\n      soundFx.playCancel();\n      soundFx.setMusicEnabled(false);\n      soundFx.setSfxEnabled(false);\n    } else {\n      soundFx.setSfxEnabled(true);\n      soundFx.setMusicEnabled(true);\n      soundFx.playToggle();\n    }\n    onToggleSound();\n  };\n\n  return (\n    <header className=\"bg-gradient-to-r from-red-600 via-red-500 to-rose-600 text-white shadow-md border-b-4 border-red-700 sticky top-0 z-40\">\n      <div className=\"max-w-7xl mx-auto px-3 sm:px-4 py-2 sm:py-2.5 flex items-center justify-between gap-2\">\n        {/* Brand & Trainer */}\n        <div className=\"flex items-center gap-2.5 sm:gap-3 min-w-0\">\n          <div className=\"relative w-9 h-9 sm:w-10 sm:h-10 bg-white/20 rounded-full flex items-center justify-center p-1 border-2 border-white/50 shadow-inner flex-shrink-0\">\n            <div className=\"w-3.5 h-3.5 sm:w-4 sm:h-4 bg-white rounded-full border-2 border-red-600 shadow flex items-center justify-center\">\n              <div className=\"w-1.5 h-1.5 bg-red-600 rounded-full animate-ping opacity-75\" />\n            </div>\n            <div className=\"absolute inset-0 rounded-full border border-white/30\" />\n          </div>\n\n          <div className=\"min-w-0\">\n            <div className=\"flex items-center gap-1.5 sm:gap-2\">\n              <h1 className=\"font-black tracking-wider text-base sm:text-xl drop-shadow-sm uppercase flex items-center gap-1\">\n                Pok\303\251Quest\n              </h1>\n              <span className=\"text-[9px] sm:text-[10px] bg-red-900/80 text-red-100 font-bold px-1.5 sm:px-2 py-0.5 rounded-full border border-red-400/40 hidden xs:inline-block\">\n                3\302\272 ESO\n              </span>\n            </div>\n            <div className=\"flex items-center gap-1.5 text-[11px] sm:text-xs text-red-100 font-medium truncate\">\n              <span className=\"truncate\">{trainer.name}</span>\n              <span>\342\200\242</span>\n              <span className=\"bg-white/20 px-1.5 py-0.2 rounded text-[10px] sm:text-[11px] font-bold whitespace-nowrap\">\n                Nv. {trainer.level}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Lead Pok\303\251mon Mini Badge (Visible on tablets and desktops) */}\n        {leadPokemon && (\n          <div className=\"hidden md:flex items-center gap-2 bg-black/20 hover:bg-black/30 transition-colors px-3 py-1.5 rounded-xl border border-white/20\">\n            <img\n              src={leadPokemon.sprite}\n              alt={leadPokemon.name}\n              className=\"w-8 h-8 object-contain pixelated drop-shadow\"\n            />\n            <div className=\"text-xs\">\n              <p className=\"font-bold text-white leading-tight\">\n                {leadPokemon.nickname || leadPokemon.name}\n              </p>\n              <p className=\"text-[10px] text-red-200\">\n                Nv. {leadPokemon.level} \342\200\242 {leadPokemon.hp}/{leadPokemon.maxHp} HP\n              </p>\n            </div>\n          </div>\n        )}\n\n        {/* Currency & Quick Audio Controls */}\n        <div className=\"flex items-center gap-1.5 sm:gap-3 text-xs font-bold flex-shrink-0\">\n          {/* Steps Today */}\n          <div\n            className=\"flex items-center gap-1 sm:gap-1.5 bg-white/15 px-2 sm:px-3 py-1.5 rounded-xl border border-white/25 shadow-sm\"\n            title=\"Pasos Health Connect hoy\"\n          >\n            <Footprints className=\"w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-300 flex-shrink-0\" />\n            <span className=\"text-emerald-100 text-[11px] sm:text-xs\">{trainer.stepsToday.toLocaleString()}</span>\n            <span className=\"text-[9px] sm:text-[10px] text-white/70 hidden sm:inline\">\n              / {trainer.stepGoal.toLocaleString()}\n            </span>\n          </div>\n\n          {/* Gold */}\n          <div\n            className=\"flex items-center gap-1 sm:gap-1.5 bg-amber-400/20 text-amber-200 px-2 sm:px-3 py-1.5 rounded-xl border border-amber-300/40 shadow-sm\"\n            title=\"Pok\303\251-monedas \342\202\275\"\n          >\n            <Coins className=\"w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-300 flex-shrink-0\" />\n            <span className=\"text-amber-100 text-[11px] sm:text-xs\">{trainer.gold.toLocaleString()} \342\202\275</span>\n          </div>\n\n          {/* Master Sound Button */}\n          <button\n            onClick={handleToggleSoundMaster}\n            className={`p-1.5 sm:p-2 rounded-xl border transition-all cursor-pointer min-w-[36px] min-h-[36px] flex items-center justify-center ${\n              isMusicOn || isSfxOn\n                ? \'bg-white/20 hover:bg-white/30 border-white/30 text-white shadow-sm\'\n                : \'bg-black/30 hover:bg-black/40 border-white/10 text-white/50\'\n            }`}\n            title={isMusicOn || isSfxOn ? \'Audio activado (clic para silenciar todo)\' : \'Audio silenciado (clic para activar)\'}\n          >\n            {isMusicOn ? (\n              <Music className=\"w-4 h-4 text-emerald-300 animate-pulse\" />\n            ) : isSfxOn ? (\n              <Volume2 className=\"w-4 h-4 text-white\" />\n            ) : (\n              <VolumeX className=\"w-4 h-4 text-white/60\" />\n            )}\n          </button>\n\n          {/* Reset button */}\n          <button\n            onClick={() => {\n              soundFx.playCancel();\n              onResetData();\n            }}\n            className=\"p-1.5 sm:p-2 bg-white/10 hover:bg-red-800 rounded-xl border border-white/20 transition-colors cursor-pointer text-white/80 hover:text-white min-w-[36px] min-h-[36px] flex items-center justify-center\"\n            title=\"Reiniciar datos iniciales\"\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
