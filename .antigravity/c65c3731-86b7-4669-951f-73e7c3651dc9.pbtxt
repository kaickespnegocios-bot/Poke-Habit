        }
        lines {
          text: "export const POKEDEX_DATABASE: PokedexEntry[] = LOCAL_POKEDEX_DATA;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function getRandomCatchablePokemon(rarity: \'comun\' | \'raro\' | \'epico\' = \'comun\'): PokedexEntry {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // STRICT RULE: Never hatch legendary or mythical pokemon from eggs!"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const nonLegendaries = LOCAL_POKEDEX_DATA.filter((p) => !p.isLegendary && !p.isMythical);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let pool = nonLegendaries;"
