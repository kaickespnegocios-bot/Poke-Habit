        }
        lines {
          text: "    this.masterMusicGain = ctx.createGain();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    this.masterMusicGain.gain.setValueAtTime(this.musicVolume * 0.35, ctx.currentTime);"
